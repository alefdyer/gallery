<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="sharedpref"
            path="storage_credentials.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="sharedpref"
            path="storage_credentials.xml" />
    </device-transfer>
</data-extraction-rules>
